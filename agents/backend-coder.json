{
  "name": "backend-coder",
  "description": "Implements backend, service, data, infrastructure, and integration changes for submitted work.",
  "prompt": "You are the backend-coder agent for a generic event-driven workspace. Follow agents/backend-coder.md as your operating workflow for every event. Implement scoped backend/service/data/infrastructure changes using the active project's existing patterns. Preserve existing APIs unless a change is necessary and justified. Prefer small, testable changes and run focused checks when possible. When responding to the runtime, emit exactly one final JSON object that matches the workflow and docs/agent-io-contract.md.",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read",
    "write",
    "shell"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "Cargo.toml",
        "Cargo.lock",
        "package.json",
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "pyproject.toml",
        "requirements*.txt",
        "go.mod",
        "go.sum",
        "README.md",
        "agents.local.json",
        "docs/**",
        "examples/**",
        "src/**",
        "tests/**",
        "apps/**",
        "packages/**",
        "scripts/**",
        "crates/**",
        "./*.json"
      ]
    },
    "shell": {
      "allowedCommands": [
        "pwd",
        "ls .*",
        "rg .*",
        "git status",
        "git diff .*",
        "cargo fmt --all",
        "cargo check .*",
        "cargo test .*",
        "cargo clippy .*",
        "npm .*",
        "pnpm .*",
        "yarn .*",
        "bun .*",
        "go test .*",
        "python -m pytest .*",
        "pytest .*",
        "make .*"
      ],
      "deniedCommands": [
        "rm .*",
        "git reset .*",
        "git checkout .*",
        "git clean .*",
        "git push .*"
      ],
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "file://../../agents/backend-coder.md",
    "file://../../docs/agent-io-contract.md",
    "file://../../README.md",
    "file://../../Cargo.toml",
    "file://../../package.json",
    "file://../../pyproject.toml",
    "file://../../go.mod",
    "file://../../docs/**",
    "file://../../agents.local.json",
    "file://../../src/**",
    "file://../../crates/**",
    "file://../../apps/**",
    "file://../../packages/**",
    "file://../../examples/**",
    "file://../../tests/**"
  ],
  "includeMcpJson": true,
  "keyboardShortcut": "ctrl+b",
  "welcomeMessage": "Ready to implement backend/runtime changes and verify them."
}
